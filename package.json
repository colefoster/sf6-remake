{
  "name": "sf6-engine",
  "version": "0.1.0",
  "description": "A headless (CLI) Street Fighter 6 frame-data engine. Ask it whether X into Y from scenario Z ends plus or minus, is punishable, or leaves a gap.",
  "type": "module",
  "bin": {
    "sf6": "./src/cli/index.ts"
  },
  "scripts": {
    "sf6": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "web:build": "node scripts/build-site.mjs",
    "geometry": "node scripts/extract-geometry.mjs",
    "geometry:2024": "node scripts/fetch-mmdk.mjs && MMDK_RAW=data/raw/mmdk-2024 GEOMETRY_OUT=/tmp/geometry-2024 node scripts/extract-geometry.mjs",
    "pose:audit": "tsx scripts/pose-audit.ts",
    "figure:sheet": "node scripts/figure-sheet.mjs",
    "web": "node scripts/build-site.mjs && python3 -m http.server 8777 --directory web",
    "play": "node scripts/build-play.mjs && python3 -m http.server 8777 --directory web",
    "build:play": "node scripts/build-play.mjs"
  },
  "keywords": [
    "street-fighter",
    "sf6",
    "frame-data",
    "fgc",
    "engine"
  ],
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
